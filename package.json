{
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/cli": "^0.1.19",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "ajv": "8.20.0",
    "allure-commandline": "2.46.1",
    "allure-playwright": "^3.12.1",
    "dotenv": "^18.0.5",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:todo-mvc": "playwright test tests/todo-mvc",
    "test:ui-testing-playground": "playwright test tests/ui-testing-playground",
    "test:orange-hrm": "playwright test tests/orange-hrm",
    "test:saucedemo": "playwright test tests/saucedemo",
    "test:saucedemo:update-snapshots": "playwright test tests/saucedemo --update-snapshots",
    "build:ai": "esbuild ai/failure-summaries/src/*.ts --platform=node --format=cjs --target=node20 --outdir=ai/failure-summaries/dist",
    "clean:ai": "node scripts/clean-ai.js",
    "pretest": "npm run build:ai",
    "preai:gen-summary": "npm run build:ai",
    "ai:gen-summary": "node ai/failure-summaries/dist/generate-summary.js",
    "preai:reporter-sample": "npm run build:ai",
    "ai:reporter-sample": "node ai/failure-summaries/dist/generate-summary.js ai/failure-summaries/fixtures/sample-artifact.json",
    "pretest:framework": "npm run build:ai",
    "test:framework": "playwright test --config=api/config/framework.playwright.config.ts"
  },
  "dependencies": {
    "playwright": "^1.62.1"
  }
}
